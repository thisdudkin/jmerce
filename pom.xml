<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
    </parent>

    <groupId>by.raddan</groupId>
    <artifactId>jmerce-parent</artifactId>
    <packaging>pom</packaging>
    <version>0.0.1</version>

    <modules>
        <module>jmerce-customer-service</module>
    </modules>

    <properties>
        <!-- General Settings -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- MapStruct Settings -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>

        <!-- JaCoCo Settings -->
        <jacoco.plugin.version>0.8.15</jacoco.plugin.version>
        <jacoco.branch.coverage.minimum>0.70</jacoco.branch.coverage.minimum>

        <!-- Other Settings -->
        <datasource.proxy.version>2.0.1</datasource.proxy.version>

        <!-- OpenAPI Code Generation -->
        <openapi-generator.plugin.version>7.24.0</openapi-generator.plugin.version>
        <openapi.generator.api-package>${project.groupId}.rest.api</openapi.generator.api-package>
        <openapi.generator.model-package>${project.groupId}.rest.dto</openapi.generator.model-package>
        <openapi.generator.input-spec>${maven.multiModuleProjectDirectory}/api/${project.artifactId}.yaml
        </openapi.generator.input-spec>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Lombok & MapStruct Integration -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok.mapstruct.binding.version}</version>
            </dependency>

            <!-- SQL Logging -->
            <dependency>
                <groupId>com.github.gavlyukovskiy</groupId>
                <artifactId>datasource-proxy-spring-boot-starter</artifactId>
                <version>${datasource.proxy.version}</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Maven Plugin: Compiler -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.hibernate.orm</groupId>
                                <artifactId>hibernate-processor</artifactId>
                            </path>
                        </annotationProcessorPaths>
                        <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    </configuration>
                </plugin>

                <!-- Maven Plugin: Code Coverage -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.plugin.version}</version>
                    <executions>
                        <!-- Attach JaCoCo Agent Before Tests -->
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>

                        <!-- Generate Coverage Report -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>

                        <!-- Enforce Coverage Threshold -->
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.branch.coverage.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- OpenAPI Code Generation -->
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.plugin.version}</version>
                    <executions>
                        <execution>
                            <id>openapi-gen</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                            <configuration>
                                <library>spring-boot</library>
                                <generateApis>true</generateApis>
                                <cleanupOutput>true</cleanupOutput>
                                <generatorName>spring</generatorName>
                                <generateModels>true</generateModels>
                                <generateApiTests>false</generateApiTests>
                                <generateModelTests>false</generateModelTests>
                                <addCompileSourceRoot>true</addCompileSourceRoot>
                                <inputSpec>${openapi.generator.input-spec}</inputSpec>
                                <generateSupportingFiles>false</generateSupportingFiles>
                                <apiPackage>${openapi.generator.api-package}</apiPackage>
                                <generateApiDocumentation>false</generateApiDocumentation>
                                <generateModelDocumentation>false</generateModelDocumentation>
                                <modelPackage>${openapi.generator.model-package}</modelPackage>
                                <output>${project.build.directory}/generated-sources/openapi</output>
                                <configOptions>
                                    <useTags>true</useTags>
                                    <useJackson3>true</useJackson3>
                                    <useSwaggerUI>false</useSwaggerUI>
                                    <interfaceOnly>true</interfaceOnly>
                                    <useSpringBoot4>true</useSpringBoot4>
                                    <openApiNullable>false</openApiNullable>
                                    <sourceFolder>src/main/java</sourceFolder>
                                    <useResponseEntity>true</useResponseEntity>
                                    <annotationLibrary>none</annotationLibrary>
                                    <skipDefaultInterface>true</skipDefaultInterface>
                                    <requestMappingMode>api_interface</requestMappingMode>
                                    <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
                                    <documentationProvider>none</documentationProvider>
                                    <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                </configOptions>
                                <!-- Reuse Spring's RFC 9457 type for shared error responses. -->
                                <inlineSchemaNameMappings>
                                    <inlineSchemaNameMapping>ProblemDetail_1=ProblemDetail</inlineSchemaNameMapping>
                                </inlineSchemaNameMappings>
                                <schemaMappings>
                                    <schemaMapping>ProblemDetail=org.springframework.http.ProblemDetail</schemaMapping>
                                    <schemaMapping>FieldError=java.lang.Object</schemaMapping>
                                </schemaMappings>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
