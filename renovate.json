{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "* 2-4 * * 5"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Manage Maven dependencies",
      "matchManagers": [
        "maven"
      ],
      "enabled": true
    },
    {
      "description": "Dependabot manages GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "description": "Group Maven patch and minor updates",
      "matchManagers": [
        "maven"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Maven non-major dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Paketo builder image",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+<paketo\\.builder\\.version>(?<currentValue>[^<]+)</paketo\\.builder\\.version>"
      ]
    }
  ]
}
